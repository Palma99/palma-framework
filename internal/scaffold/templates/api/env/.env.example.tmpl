APP_HTTP_ADDRESS=:8080
APP_HTTP_READ_HEADER_TIMEOUT=5s
APP_HTTP_SHUTDOWN_TIMEOUT=10s

# Common settings; copy to .env. Environment-specific files override these.
# PostgreSQL is required in all API environments.
# PostgreSQL via pgx; import another SQL driver in the provider if needed.
APP_DB_DRIVER=pgx
APP_DB_DSN=
# Optional replica named "report"; no automatic routing or primary fallback.
APP_DB_REPLICA_DSN=
APP_DB_CONNECT_TIMEOUT=5s
APP_DB_MAX_OPEN_CONNS=20
APP_DB_MAX_IDLE_CONNS=5
APP_DB_CONN_MAX_LIFETIME=30m
APP_DB_CONN_MAX_IDLE_TIME=5m
