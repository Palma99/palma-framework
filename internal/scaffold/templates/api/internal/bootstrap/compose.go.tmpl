//go:build pfw_inject

package bootstrap

import (
 pfw "github.com/palma99/palma-framework"
 "{{.Module}}/internal/config"
 "github.com/palma99/palma-framework/transport/httpserver"
)

func Initialize(env pfw.Environment, cfg config.Config) (*httpserver.Server, func() error, error) {
 return pfw.BuildWithCleanup[*httpserver.Server](
  pfw.Environments("{{.Environment}}"),
  pfw.Discover("../..."),
  pfw.AutoBind(),
 )
}
