//go:build pfw_inject

package bootstrap

import (
 "net/http"
 pfw "github.com/palma99/palma-framework"
 "{{.Module}}/internal/config"
 itemhttp "{{.Module}}/internal/item/infrastructure/http"
 "{{.Module}}/internal/item/infrastructure/memory"
 "{{.Module}}/internal/item/application"
 apihttp "{{.Module}}/internal/platform/http"
)

func Initialize(env pfw.Environment, cfg config.Config) (*http.Server, func() error, error) {
 return pfw.BuildWithCleanup[*http.Server](
  pfw.Environments("{{.Environment}}"),
  pfw.Constructors(memory.NewStore, application.NewService, itemhttp.NewHandler, apihttp.Routes, apihttp.Server),
  pfw.Bind[application.Repository, *memory.Store](),
 )
}
