package memory

import (
 "context"
 "strconv"
 "sync"
 "{{.Module}}/internal/item/application"
 "{{.Module}}/internal/item/domain"
)

// Store is an in-memory infrastructure implementation; data is lost when the process stops.
type Store struct { mu sync.RWMutex; items []domain.Item; next uint64 }
var _ application.Repository = (*Store)(nil)

func NewStore() *Store { return &Store{items: []domain.Item{}} }

func (s *Store) List(ctx context.Context) ([]domain.Item, error) {
 if err := ctx.Err(); err != nil { return nil, err }
 s.mu.RLock(); defer s.mu.RUnlock()
 return append([]domain.Item{}, s.items...), nil
}
func (s *Store) Get(ctx context.Context, id string) (domain.Item, error) {
 if err := ctx.Err(); err != nil { return domain.Item{}, err }
 s.mu.RLock(); defer s.mu.RUnlock()
 for _, item := range s.items { if item.ID == id { return item, nil } }
 return domain.Item{}, domain.ErrNotFound
}
func (s *Store) Save(ctx context.Context, item domain.Item) (domain.Item, error) {
 if err := ctx.Err(); err != nil { return domain.Item{}, err }
 s.mu.Lock(); defer s.mu.Unlock()
 s.next++
 item.ID = strconv.FormatUint(s.next, 10)
 s.items = append(s.items, item)
 return item, nil
}
