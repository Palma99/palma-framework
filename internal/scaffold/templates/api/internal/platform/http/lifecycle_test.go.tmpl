package apihttp_test

import (
 "bytes"
 "context"
 "io"
 "github.com/palma99/palma-framework/logging"
 "net"
 "net/http"
 "strings"
 "testing"
 "time"
 apihttp "{{.Module}}/internal/platform/http"
)

func captureLogs(t *testing.T) *bytes.Buffer {
 t.Helper()
 var output bytes.Buffer
 return &output
}

func TestServerLogsReadinessAfterBinding(t *testing.T) {
 output := captureLogs(t)
 server := apihttp.NewLifecycleServer(&http.Server{Addr: "127.0.0.1:0", Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request){ io.WriteString(w,"ready") })}, "{{.Environment}}", logging.New(logging.Options{Output: output}))
 if output.Len() != 0 { t.Fatal("logged readiness during construction") }
 if err := server.Start(context.Background()); err != nil { t.Fatal(err) }
 t.Cleanup(func(){
  ctx, cancel := context.WithTimeout(context.Background(), time.Second); defer cancel()
  if err := server.Stop(ctx); err != nil { t.Error(err) }
  if err := server.Wait(); err != nil { t.Error(err) }
 })
 address := server.Addr().String()
 if !strings.Contains(output.String(), "msg=\"server started\" address="+address+" environment={{.Environment}}") { t.Fatalf("readiness log: %s",output) }
 client := &http.Client{Timeout: time.Second}
 defer client.CloseIdleConnections()
 response, err := client.Get("http://"+address)
 if err != nil { t.Fatal(err) }
 defer response.Body.Close()
 body, err := io.ReadAll(response.Body)
 if err != nil || string(body) != "ready" { t.Fatalf("server not ready: %s %v",body,err) }
}

func TestFailedBindDoesNotLogReadiness(t *testing.T) {
 output := captureLogs(t)
 occupied, err := net.Listen("tcp", "127.0.0.1:0")
 if err != nil { t.Fatal(err) }
 defer occupied.Close()
 server := apihttp.NewLifecycleServer(&http.Server{Addr: occupied.Addr().String()}, "{{.Environment}}", logging.New(logging.Options{Output: output}))
 if err := server.Start(context.Background()); err == nil { t.Fatal("expected occupied port error") }
 if output.Len() != 0 { t.Fatalf("failed start logged readiness: %s",output) }
}
