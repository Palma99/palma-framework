package apihttp

import (
 "context"
 "net/http"
 pfw "github.com/palma99/palma-framework"
 "github.com/palma99/palma-framework/transport/httpserver"
 "github.com/palma99/palma-framework/logging"
)

// LifecycleServer logs readiness only after the listener has been bound.
type LifecycleServer struct {
 *httpserver.Server
 HTTP *http.Server
 environment pfw.Environment
 Logger logging.Logger
}

//pfw:coconut
func NewLifecycleServer(server *http.Server, env pfw.Environment, logger logging.Logger) *LifecycleServer {
 return &LifecycleServer{Server: httpserver.New(server), HTTP: server, environment: env, Logger: logger}
}

func (s *LifecycleServer) Start(ctx context.Context) error {
 if err := s.Server.Start(ctx); err != nil { return err }
 s.Logger.Info(ctx, "server started", "address", s.Addr().String(), "environment", s.environment)
 return nil
}
