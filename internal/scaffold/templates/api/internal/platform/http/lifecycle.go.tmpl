package apihttp

import (
 "context"
 "log"
 "net/http"
 pfw "github.com/palma99/palma-framework"
 "github.com/palma99/palma-framework/transport/httpserver"
)

// LifecycleServer logs readiness only after the listener has been bound.
type LifecycleServer struct {
 *httpserver.Server
 HTTP *http.Server
 environment pfw.Environment
}

//pfw:coconut
func NewLifecycleServer(server *http.Server, env pfw.Environment) *LifecycleServer {
 return &LifecycleServer{Server: httpserver.New(server), HTTP: server, environment: env}
}

func (s *LifecycleServer) Start(ctx context.Context) error {
 if err := s.Server.Start(ctx); err != nil { return err }
 log.Printf("server started address=%s environment=%s", s.Addr().String(), s.environment)
 return nil
}
