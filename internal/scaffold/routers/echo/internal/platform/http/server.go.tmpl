package apihttp

import (
 "net/http"
 "github.com/labstack/echo/v5"
 pfwhttp "github.com/palma99/palma-framework/http"
 "github.com/palma99/palma-framework/logging"
 pfwecho "github.com/palma99/palma-framework/transport/echo"
 "{{.Module}}/internal/config"
 itemhttp "{{.Module}}/internal/item/infrastructure/http"
)

//pfw:coconut
func Routes(items *itemhttp.Controller, errors pfwhttp.ErrorMapper, logger logging.Logger) *echo.Echo {
 router := echo.New()
 router.HTTPErrorHandler = pfwecho.ErrorHandler(errors, logger)
 router.GET("/health", func(ctx *echo.Context) error {
  return pfwhttp.OK(map[string]string{"status":"ok"}).Write(ctx.Response())
 })
 items.Register(router.Group("/items"))
 return router
}

//pfw:coconut
func Server(router *echo.Echo, cfg config.Config) *http.Server {
 return &http.Server{Addr: cfg.HTTP.Address, Handler: router, ReadHeaderTimeout: cfg.HTTP.ReadHeaderTimeout}
}
