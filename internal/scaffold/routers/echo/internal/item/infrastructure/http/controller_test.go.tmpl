package itemhttp_test

import (
 "net/http/httptest"
 "strings"
 "testing"
 "github.com/labstack/echo/v5"
 pfwecho "github.com/palma99/palma-framework/transport/echo"
 itemhttp "{{.Module}}/internal/item/infrastructure/http"
 "{{.Module}}/internal/item/application"
 "{{.Module}}/internal/item/infrastructure/memory"
)

func TestControllerMountAndMiddleware(t *testing.T) {
 controller := itemhttp.NewController(application.NewService(memory.NewStore()))
 router := echo.New()
 router.HTTPErrorHandler = pfwecho.ErrorHandler(itemhttp.NewErrorMapper(), nil)
 controller.Register(router.Group("/api/v1/items"))
 controller.Register(router.Group("/admin/items", func(next echo.HandlerFunc) echo.HandlerFunc {
  return func(ctx *echo.Context) error { return echo.ErrUnauthorized }
 }))
 request := func(method, path, body string) *httptest.ResponseRecorder {
  r := httptest.NewRequest(method, path, strings.NewReader(body))
  r.Header.Set("Content-Type", "application/json")
  w := httptest.NewRecorder(); router.ServeHTTP(w, r); return w
 }
 if w := request("POST", "/admin/items", `{"name":"Blocked"}`); w.Code != 401 { t.Fatalf("protected: %d %s", w.Code, w.Body) }
 if w := request("GET", "/api/v1/items", ""); w.Code != 200 || strings.TrimSpace(w.Body.String()) != "[]" { t.Fatalf("public: %d %s", w.Code, w.Body) }
 created := request("POST", "/api/v1/items", `{"name":"Ada"}`)
 location := created.Header().Get("Location")
 if created.Code != 201 || !strings.HasPrefix(location, "/api/v1/items/") { t.Fatalf("location: %d %q", created.Code, location) }
 if w := request("GET", location, ""); w.Code != 200 || w.Body.String() != created.Body.String() { t.Fatalf("get: %d %s", w.Code, w.Body) }
}
