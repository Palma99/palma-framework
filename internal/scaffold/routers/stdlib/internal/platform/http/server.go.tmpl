package apihttp

import (
 "net/http"
 pfwhttp "github.com/palma99/palma-framework/http"
 "github.com/palma99/palma-framework/logging"
 "{{.Module}}/internal/config"
 itemhttp "{{.Module}}/internal/item/infrastructure/http"
)

//pfw:coconut
func Routes(items *itemhttp.Controller, logger logging.Logger) *http.ServeMux {
 mux := http.NewServeMux()
 mux.HandleFunc("GET /health", func(w http.ResponseWriter, r *http.Request) {
  if err := pfwhttp.OK(map[string]string{"status":"ok"}).Write(w); err != nil { logger.Error(r.Context(), "health response failed", "error", err) }
 })
 items.Register(mux, "/items")
 return mux
}

//pfw:coconut
func Server(mux *http.ServeMux, cfg config.Config) *http.Server {
 return &http.Server{Addr: cfg.HTTP.Address, Handler: mux, ReadHeaderTimeout: cfg.HTTP.ReadHeaderTimeout}
}

//pfw:coconut
func HandlerAdapter(errors pfwhttp.ErrorMapper, logger logging.Logger) *pfwhttp.HandlerAdapter {
 return pfwhttp.NewHandlerAdapter(errors, logger)
}
