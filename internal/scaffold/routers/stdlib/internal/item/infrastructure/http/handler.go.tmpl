package itemhttp

import (
 "net/http"
 "context"
 pfwhttp "github.com/palma99/palma-framework/http"
 "github.com/palma99/palma-framework/logging"
 "{{.Module}}/internal/item/application"
)

type Handler struct {
  service *application.Service;
  errors pfwhttp.ErrorMapper;
  logger logging.Logger;
}

//pfw:coconut
func NewHandler(
  service *application.Service,
  errors pfwhttp.ErrorMapper,
  logger logging.Logger,
) *Handler {
  return &Handler{
    service: service,
    errors: errors,
    logger: logger,
  }
}

func (h *Handler) Register(mux *http.ServeMux) {
  mux.HandleFunc("GET /items", h.list)
  mux.HandleFunc("GET /items/{id}", h.get)
  mux.HandleFunc("POST /items", h.create)
}

func (h *Handler) report(ctx context.Context, err error) {
  if err != nil {
    h.logger.Error(ctx, "HTTP response failed", "error", err)
  }
}

func (h *Handler) fail(w http.ResponseWriter, r *http.Request, err error) {
  mapped := h.errors.Map(err)
  if mapped.Status >= 500 {
    h.logger.Error(r.Context(), "request failed", "error", err)
  }
  h.report(r.Context(), mapped.Write(w))
}

func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
  items, err := h.service.List(r.Context())
  if err != nil {
    h.fail(w, r, err);
    return
  }

  result := make([]itemResponse, 0, len(items))
  for _, item := range items {
    result = append(result, response(item))
  }

  h.report(r.Context(), pfwhttp.OK(result).Write(w))
}

func (h *Handler) get(w http.ResponseWriter, r *http.Request) {
  item, err := h.service.Get(r.Context(), r.PathValue("id"))
  if err != nil {
    h.fail(w, r, err);
    return
  }

  h.report(r.Context(), pfwhttp.OK(response(item)).Write(w))
}

func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
  input, err := pfwhttp.DecodeJSON[struct { Name string `json:"name"` }](r, pfwhttp.DecodeOptions{})
  if err != nil {
    h.fail(w, r, err)
    return
  }

  item, err := h.service.Create(r.Context(), input.Name)
  if err != nil {
    h.fail(w, r, err)
    return
  }

  h.report(r.Context(), pfwhttp.Created("/items/"+item.ID, response(item)).Write(w))
}
