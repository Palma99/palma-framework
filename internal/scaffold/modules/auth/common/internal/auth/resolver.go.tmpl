package auth

import (
 "context"
)

type PrincipalResolver struct{}
//pfw:coconut
func NewPrincipalResolver() *PrincipalResolver { return &PrincipalResolver{} }
func (*PrincipalResolver) Resolve(ctx context.Context, identity VerifiedJWT) (Principal,error) {
 if err := ctx.Err(); err != nil { return Principal{},err }
 return Principal{UserID:identity.Subject,Roles:append([]string(nil),identity.Roles...)}, nil
}

