package auth

import (
 "context"
 "errors"
 "fmt"
 "net/http"
 "strings"

 "github.com/golang-jwt/jwt/v5"
 pfwsecurity "github.com/palma99/palma-framework/security"
 securityhttp "github.com/palma99/palma-framework/security/http"
 pfwhttp "github.com/palma99/palma-framework/http"
 "{{.Module}}/internal/config"
)

type BearerCredentials struct { Token string }
type Claims struct {
 jwt.RegisteredClaims
 Roles []string `json:"roles,omitempty"`
}
type VerifiedJWT struct { Subject string; Roles []string }

// Principal belongs to the application; extend its fields and claim mapping.
type Principal struct { UserID string `json:"user_id"`; Roles []string `json:"roles"` }

type BearerExtractor struct{}

// BearerChallenge adds the scheme-specific challenge to unauthorized responses.
func BearerChallenge(next http.Handler) http.Handler {
 return http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){next.ServeHTTP(&challengeWriter{ResponseWriter:w},r)})
}
type challengeWriter struct { http.ResponseWriter }
func(w *challengeWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
func(w *challengeWriter) WriteHeader(status int){
 if status == http.StatusUnauthorized { w.Header().Set("WWW-Authenticate","Bearer") }
 w.ResponseWriter.WriteHeader(status)
}
//pfw:coconut
func NewBearerExtractor() *BearerExtractor { return &BearerExtractor{} }
func (*BearerExtractor) Extract(r *http.Request) (BearerCredentials, error) {
 headers := r.Header.Values("Authorization")
 if len(headers) == 0 { return BearerCredentials{}, pfwsecurity.ErrMissingCredentials }
 if len(headers) != 1 { return BearerCredentials{}, pfwsecurity.ErrInvalidCredentials }
 parts := strings.Fields(headers[0])
 if len(parts) != 2 || !strings.EqualFold(parts[0],"Bearer") { return BearerCredentials{}, pfwsecurity.ErrInvalidCredentials }
 return BearerCredentials{Token:parts[1]}, nil
}

type JWTAuthenticator struct { key []byte; issuer, audience string }
// NewJWTAuthenticator permits an unconfigured module to boot, but authentication
// fails with a configuration error until a secret is provided. There is no demo
// signing secret or fallback identity. A configured secret must have 32+ bytes.
//pfw:coconut
func NewJWTAuthenticator(cfg config.Config) (*JWTAuthenticator, error) {
 if cfg.Auth.JWTSecret != "" && len(cfg.Auth.JWTSecret) < 32 { return nil, errors.New("auth: JWT_SECRET must contain at least 32 bytes") }
 issuer, audience := cfg.Auth.JWTIssuer, cfg.Auth.JWTAudience
 if issuer == "" { issuer = "palma-api" }
 if audience == "" { audience = "palma-api" }
 return &JWTAuthenticator{key:[]byte(cfg.Auth.JWTSecret),issuer:issuer,audience:audience}, nil
}
func (a *JWTAuthenticator) Authenticate(ctx context.Context, credentials BearerCredentials) (VerifiedJWT, error) {
 if err := ctx.Err(); err != nil { return VerifiedJWT{}, err }
 if len(a.key) == 0 { return VerifiedJWT{}, errors.New("auth: configure APP_AUTH_JWT_SECRET before authenticating") }
 claims := &Claims{}
 token, err := jwt.ParseWithClaims(credentials.Token,claims,func(*jwt.Token)(any,error){ return a.key,nil },
  jwt.WithValidMethods([]string{jwt.SigningMethodHS256.Alg()}),jwt.WithIssuer(a.issuer),
  jwt.WithAudience(a.audience),jwt.WithExpirationRequired(),jwt.WithIssuedAt(),
 )
 if err != nil { return VerifiedJWT{}, fmt.Errorf("%w: %w",pfwsecurity.ErrInvalidCredentials,err) }
 if !token.Valid || strings.TrimSpace(claims.Subject) == "" { return VerifiedJWT{}, pfwsecurity.ErrInvalidCredentials }
 return VerifiedJWT{Subject:claims.Subject,Roles:append([]string(nil),claims.Roles...)}, nil
}

type PrincipalResolver struct{}
//pfw:coconut
func NewPrincipalResolver() *PrincipalResolver { return &PrincipalResolver{} }
func (*PrincipalResolver) Resolve(ctx context.Context, identity VerifiedJWT) (Principal,error) {
 if err := ctx.Err(); err != nil { return Principal{},err }
 return Principal{UserID:identity.Subject,Roles:append([]string(nil),identity.Roles...)}, nil
}

type Middleware = securityhttp.Middleware[BearerCredentials, VerifiedJWT, Principal]
//pfw:coconut
func NewMiddleware(extractor securityhttp.CredentialExtractor[BearerCredentials], authenticator pfwsecurity.Authenticator[BearerCredentials, VerifiedJWT], resolver pfwsecurity.PrincipalResolver[VerifiedJWT, Principal], mapper pfwhttp.ErrorMapper) (*Middleware,error) {
 return securityhttp.NewMiddleware(extractor,authenticator,resolver,mapper)
}
