package auth

import (
 "net/http"
 "strings"
 pfwsecurity "github.com/palma99/palma-framework/security"
)

type BearerExtractor struct{}

// BearerChallenge adds the scheme-specific challenge to unauthorized responses.
func BearerChallenge(next http.Handler) http.Handler {
 return http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){next.ServeHTTP(&challengeWriter{ResponseWriter:w},r)})
}
type challengeWriter struct { http.ResponseWriter }
func(w *challengeWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
func(w *challengeWriter) WriteHeader(status int){
 if status == http.StatusUnauthorized { w.Header().Set("WWW-Authenticate","Bearer") }
 w.ResponseWriter.WriteHeader(status)
}
//pfw:coconut
func NewBearerExtractor() *BearerExtractor { return &BearerExtractor{} }
func (*BearerExtractor) Extract(r *http.Request) (BearerCredentials, error) {
 headers := r.Header.Values("Authorization")
 if len(headers) == 0 { return BearerCredentials{}, pfwsecurity.ErrMissingCredentials }
 if len(headers) != 1 { return BearerCredentials{}, pfwsecurity.ErrInvalidCredentials }
 parts := strings.Fields(headers[0])
 if len(parts) != 2 || !strings.EqualFold(parts[0],"Bearer") { return BearerCredentials{}, pfwsecurity.ErrInvalidCredentials }
 return BearerCredentials{Token:parts[1]}, nil
}

