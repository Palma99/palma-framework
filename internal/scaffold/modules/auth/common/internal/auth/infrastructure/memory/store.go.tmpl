package memory

import (
 "context"
 "time"
 "{{.Module}}/internal/auth"
)

// Store is used only by the local environment. Replace with your session issuer.
type Store struct { expires time.Time }
//pfw:coconut
func NewStore() *Store { return &Store{expires:time.Now().Add(time.Hour)} }
func (s *Store) FindSession(ctx context.Context, id string) (auth.Session, error) {
 if err := ctx.Err(); err != nil { return auth.Session{}, err }
 if id != "local-demo-session" { return auth.Session{}, auth.ErrSessionNotFound }
 return auth.Session{UserID:"local-user",ExpiresAt:s.expires}, nil
}
func (*Store) FindUser(ctx context.Context, id string) (auth.User, error) {
 if err := ctx.Err(); err != nil { return auth.User{}, err }
 if id != "local-user" { return auth.User{}, auth.ErrUserNotFound }
 return auth.User{ID:"local-user",Roles:[]string{"user"}}, nil
}
