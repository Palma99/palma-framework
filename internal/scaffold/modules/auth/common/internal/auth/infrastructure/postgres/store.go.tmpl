package postgres

import (
 "context"
 "crypto/sha256"
 "database/sql"
 "encoding/hex"
 "encoding/json"
 "errors"

 sqltx "github.com/palma99/palma-framework/transaction/sql"
 "{{.Module}}/internal/auth"
 appdb "{{.Module}}/internal/platform/database"
)

type Store struct { db appdb.MainDB }
//pfw:coconut
func NewStore(db appdb.MainDB) *Store { return &Store{db:db} }
func (s *Store) FindSession(ctx context.Context, id string) (auth.Session, error) {
 executor, err := sqltx.Executor(ctx, s.db.Primary())
 if err != nil { return auth.Session{}, err }
 sum := sha256.Sum256([]byte(id))
 var session auth.Session
 err = executor.QueryRowContext(ctx,"SELECT user_id, expires_at, revoked FROM pfw_auth_sessions WHERE session_hash = $1",hex.EncodeToString(sum[:])).Scan(&session.UserID,&session.ExpiresAt,&session.Revoked)
 if errors.Is(err,sql.ErrNoRows) { return auth.Session{}, auth.ErrSessionNotFound }
 return session, err
}
func (s *Store) FindUser(ctx context.Context, id string) (auth.User, error) {
 executor, err := sqltx.Executor(ctx, s.db.Primary())
 if err != nil { return auth.User{}, err }
 var user auth.User
 var roles []byte
 err = executor.QueryRowContext(ctx,"SELECT id, roles, disabled FROM pfw_auth_users WHERE id = $1",id).Scan(&user.ID,&roles,&user.Disabled)
 if errors.Is(err,sql.ErrNoRows) { return auth.User{}, auth.ErrUserNotFound }
 if err != nil { return auth.User{}, err }
 if err := json.Unmarshal(roles,&user.Roles); err != nil { return auth.User{}, err }
 return user, nil
}
