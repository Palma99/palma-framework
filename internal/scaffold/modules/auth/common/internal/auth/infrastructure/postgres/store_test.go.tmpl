package postgres_test

import (
 "context"
 "crypto/sha256"
 "database/sql"
 "database/sql/driver"
 "encoding/hex"
 "errors"
 "io"
 "strings"
 "testing"
 "time"

 pfwdb "github.com/palma99/palma-framework/database"
 "{{.Module}}/internal/auth"
 authpostgres "{{.Module}}/internal/auth/infrastructure/postgres"
 appdb "{{.Module}}/internal/platform/database"
)

type authDriver struct{}
type authConnection struct { scenario string }
func (authDriver) Open(scenario string)(driver.Conn,error){return authConnection{scenario:scenario},nil}
func (authConnection) Prepare(string)(driver.Stmt,error){return nil,errors.New("unsupported")}
func (authConnection) Begin()(driver.Tx,error){return nil,errors.New("unsupported")}
func (authConnection) Close()error{return nil}
func (authConnection) Ping(context.Context)error{return nil}
func (c authConnection) QueryContext(ctx context.Context,query string,args []driver.NamedValue)(driver.Rows,error){
 if err:=ctx.Err();err!=nil{return nil,err}
 if c.scenario=="failed"{return nil,errBackend}
 if strings.Contains(query,"FROM pfw_auth_sessions"){
  sum:=sha256.Sum256([]byte("private-session"))
  if len(args)!=1||args[0].Value!=hex.EncodeToString(sum[:]){return nil,errors.New("session lookup must use its hash")}
  rows:=&authRows{columns:[]string{"user_id","expires_at","revoked"}}
  if c.scenario!="missing"{rows.values=[][]driver.Value{ {"user",time.Now().Add(time.Hour),false} }}
  return rows,nil
 }
 if strings.Contains(query,"FROM pfw_auth_users"){
  if len(args)!=1||args[0].Value!="user"{return nil,errors.New("user lookup must be parameterized")}
  rows:=&authRows{columns:[]string{"id","roles","disabled"}}
  roles:=[]byte(`["user","editor"]`)
  if c.scenario=="bad-roles"{roles=[]byte(`invalid`)}
  if c.scenario!="missing"{rows.values=[][]driver.Value{ {"user",roles,false} }}
  return rows,nil
 }
 return nil,errors.New("unexpected SQL")
}
type authRows struct { columns []string;values [][]driver.Value;index int }
func(r *authRows)Columns()[]string{return r.columns}
func(*authRows)Close()error{return nil}
func(r *authRows)Next(dest []driver.Value)error{if r.index==len(r.values){return io.EOF};copy(dest,r.values[r.index]);r.index++;return nil}
var errBackend=errors.New("backend failure")
func init(){sql.Register("auth-scaffold-test",authDriver{})}

func TestSQLSessionHashUserRolesAndErrors(t *testing.T){
 for _,scenario:=range []string{"valid","missing","failed","bad-roles"}{
  t.Run(scenario,func(t *testing.T){
   db,cleanup,err:=pfwdb.Open(context.Background(),pfwdb.Config{Primary:pfwdb.Endpoint{Driver:"auth-scaffold-test",DSN:scenario}})
   if err!=nil{t.Fatal(err)};t.Cleanup(func(){if err:=cleanup();err!=nil{t.Error(err)}})
   store:=authpostgres.NewStore(appdb.MainDB{Connection:db})
   session,sessionErr:=store.FindSession(context.Background(),"private-session")
   user,userErr:=store.FindUser(context.Background(),"user")
   switch scenario{
   case "missing":
    if !errors.Is(sessionErr,auth.ErrSessionNotFound)||!errors.Is(userErr,auth.ErrUserNotFound){t.Fatalf("not found: %v %v",sessionErr,userErr)}
   case "failed":
    if !errors.Is(sessionErr,errBackend)||!errors.Is(userErr,errBackend){t.Fatalf("backend: %v %v",sessionErr,userErr)}
   case "bad-roles":
    if sessionErr!=nil||userErr==nil{t.Fatalf("invalid roles: %v %v",sessionErr,userErr)}
   default:
    if sessionErr!=nil||userErr!=nil||session.UserID!="user"||user.ID!="user"||len(user.Roles)!=2{t.Fatalf("values: %+v %+v %v %v",session,user,sessionErr,userErr)}
   }
  })
 }
}
