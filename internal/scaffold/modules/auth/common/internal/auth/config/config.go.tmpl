package authconfig

import "fmt"

// Config is embedded in the application's configuration with envPrefix AUTH_.
type Config struct {
 JWTSecret string `env:"JWT_SECRET"`
 JWTIssuer string `env:"JWT_ISSUER" envDefault:"palma-api"`
 JWTAudience string `env:"JWT_AUDIENCE" envDefault:"palma-api"`
}

// Validate checks the JWT configuration before API startup.
func (c Config) Validate() error {
 if len(c.JWTSecret) < 32 {
  return fmt.Errorf("auth: APP_AUTH_JWT_SECRET must contain at least 32 bytes; configure it in the private environment file (for local: env/.env.local.local)")
 }
 return nil
}
