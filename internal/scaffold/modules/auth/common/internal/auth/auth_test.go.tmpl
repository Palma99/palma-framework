package auth_test

import (
 "context"
 "errors"
 "net/http/httptest"
 "testing"
 "time"

 "github.com/golang-jwt/jwt/v5"
 "github.com/palma99/palma-framework/security"
 "{{.Module}}/internal/auth"
 authconfig "{{.Module}}/internal/auth/config"
 "{{.Module}}/internal/config"
)

const testSecret = "test-only-secret-with-at-least-32-bytes"
func validClaims() auth.Claims {
 return auth.Claims{RegisteredClaims:jwt.RegisteredClaims{
  Subject:"user",Issuer:"test-issuer",Audience:jwt.ClaimStrings{"test-audience"},
  ExpiresAt:jwt.NewNumericDate(time.Now().Add(time.Hour)),
 },Roles:[]string{"user"}}
}
func TestJWTValidationAndPrincipal(t *testing.T) {
 authenticator,err:=auth.NewJWTAuthenticator(config.Config{Auth:authconfig.Config{JWTSecret:testSecret,JWTIssuer:"test-issuer",JWTAudience:"test-audience"}})
 if err!=nil{t.Fatal(err)}
 for _,tc:=range []struct{name string;modify func(*auth.Claims);method jwt.SigningMethod;key any;reject bool}{
  {name:"valid"},
  {name:"expired",modify:func(c *auth.Claims){c.ExpiresAt=jwt.NewNumericDate(time.Now().Add(-time.Hour))},reject:true},
  {name:"missing expiration",modify:func(c *auth.Claims){c.ExpiresAt=nil},reject:true},
  {name:"wrong issuer",modify:func(c *auth.Claims){c.Issuer="other"},reject:true},
  {name:"missing issuer",modify:func(c *auth.Claims){c.Issuer=""},reject:true},
  {name:"wrong audience",modify:func(c *auth.Claims){c.Audience=jwt.ClaimStrings{"other"}},reject:true},
  {name:"missing audience",modify:func(c *auth.Claims){c.Audience=nil},reject:true},
  {name:"missing subject",modify:func(c *auth.Claims){c.Subject=""},reject:true},
  {name:"not yet valid",modify:func(c *auth.Claims){c.NotBefore=jwt.NewNumericDate(time.Now().Add(time.Hour))},reject:true},
  {name:"future issued at",modify:func(c *auth.Claims){c.IssuedAt=jwt.NewNumericDate(time.Now().Add(time.Hour))},reject:true},
  {name:"wrong signature",key:[]byte("another-test-secret-with-32-bytes"),reject:true},
  {name:"wrong algorithm",method:jwt.SigningMethodHS384,reject:true},
  {name:"unsigned",method:jwt.SigningMethodNone,key:jwt.UnsafeAllowNoneSignatureType,reject:true},
 }{
  t.Run(tc.name,func(t *testing.T){
   claims:=validClaims();if tc.modify!=nil{tc.modify(&claims)}
   method:=tc.method;if method==nil{method=jwt.SigningMethodHS256}
   key:=tc.key;if key==nil{key=[]byte(testSecret)}
   token,err:=jwt.NewWithClaims(method,claims).SignedString(key);if err!=nil{t.Fatal(err)}
   identity,err:=authenticator.Authenticate(context.Background(),auth.BearerCredentials{Token:token})
   if tc.reject {if !errors.Is(err,security.ErrInvalidCredentials){t.Fatalf("rejection: %v",err)};return}
   if err!=nil{t.Fatal(err)}
   p,err:=auth.NewPrincipalResolver().Resolve(context.Background(),identity)
   if err!=nil||p.UserID!="user"||len(p.Roles)!=1||p.Roles[0]!="user"{t.Fatalf("principal: %+v %v",p,err)}
   identity.Roles[0]="changed";if p.Roles[0]!="user"{t.Fatal("principal aliases identity roles")}
  })
 }
}

func TestBearerExtractionAndConfiguration(t *testing.T){
 for _,tc:=range []struct{headers []string;want error}{
  {want:security.ErrMissingCredentials},
  {headers:[]string{""},want:security.ErrInvalidCredentials},
  {headers:[]string{"Bearer"},want:security.ErrInvalidCredentials},
  {headers:[]string{"Basic credentials"},want:security.ErrInvalidCredentials},
  {headers:[]string{"Bearer one two"},want:security.ErrInvalidCredentials},
  {headers:[]string{"Bearer one","Bearer two"},want:security.ErrInvalidCredentials},
  {headers:[]string{"bearer token"}},
 }{
  r:=httptest.NewRequest("GET","/",nil)
  for _,header:=range tc.headers{r.Header.Add("Authorization",header)}
  credentials,err:=auth.NewBearerExtractor().Extract(r)
  if tc.want!=nil{if !errors.Is(err,tc.want){t.Fatalf("extract: %v",err)}}else if err!=nil||credentials.Token!="token"{t.Fatalf("credentials: %+v %v",credentials,err)}
 }
 if _,err:=auth.NewJWTAuthenticator(config.Config{Auth:authconfig.Config{JWTSecret:"short"}});err==nil{t.Fatal("weak secret accepted")}
 authenticator,err:=auth.NewJWTAuthenticator(config.Config{});if err!=nil{t.Fatal(err)}
 if _,err:=authenticator.Authenticate(context.Background(),auth.BearerCredentials{Token:"token"});err==nil||errors.Is(err,security.ErrInvalidCredentials){t.Fatalf("missing secret must be a configuration error: %v",err)}
 ctx,cancel:=context.WithCancel(context.Background());cancel()
 if _,err:=authenticator.Authenticate(ctx,auth.BearerCredentials{});!errors.Is(err,context.Canceled){t.Fatalf("cancellation: %v",err)}
}

func TestMalformedRolesAndToken(t *testing.T){
 authenticator,err:=auth.NewJWTAuthenticator(config.Config{Auth:authconfig.Config{JWTSecret:testSecret}});if err!=nil{t.Fatal(err)}
 claims:=jwt.MapClaims{"sub":"user","iss":"palma-api","aud":"palma-api","exp":time.Now().Add(time.Hour).Unix(),"roles":"admin"}
 signed,err:=jwt.NewWithClaims(jwt.SigningMethodHS256,claims).SignedString([]byte(testSecret));if err!=nil{t.Fatal(err)}
 for _,token:=range []string{signed,"malformed"}{
  if _,err:=authenticator.Authenticate(context.Background(),auth.BearerCredentials{Token:token});!errors.Is(err,security.ErrInvalidCredentials){t.Fatalf("invalid token: %v",err)}
 }
}
