//go:build pfw_inject

package bootstrap

import (
 pfw "github.com/palma99/palma-framework"
 "github.com/palma99/palma-framework/security"
 securityhttp "github.com/palma99/palma-framework/security/http"
 "{{.Module}}/internal/auth"
)

// AuthModule connects the application's JWT authentication contracts.
// The bootstrap's discovery registers the annotated constructors.
var AuthModule = pfw.Module(
 pfw.Bind[securityhttp.CredentialExtractor[auth.BearerCredentials],*auth.BearerExtractor](),
 pfw.Bind[security.Authenticator[auth.BearerCredentials,auth.VerifiedJWT],*auth.JWTAuthenticator](),
 pfw.Bind[security.PrincipalResolver[auth.VerifiedJWT,auth.Principal],*auth.PrincipalResolver](),
)
