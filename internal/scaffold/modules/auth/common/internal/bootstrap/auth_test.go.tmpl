package bootstrap_test

import (
 "context"
 "net/http/httptest"
 "strings"
 "testing"
 "time"

 "github.com/golang-jwt/jwt/v5"
 pfw "github.com/palma99/palma-framework"
 "{{.Module}}/internal/auth"
 authconfig "{{.Module}}/internal/auth/config"
 bootstrap "{{.Module}}/internal/bootstrap"
 "{{.Module}}/internal/config"
)

func TestAuthEndpoints(t *testing.T){
 env,err:=pfw.EnvironmentFromEnv("local");if err!=nil{t.Fatal(err)}
 if env!="local"{t.Skip("bootstrap endpoint fixtures use local item storage")}
 const secret="test-only-secret-with-at-least-32-bytes"
 cfg:=config.Config{Auth:authconfig.Config{JWTSecret:secret},HTTP:config.HTTPConfig{Address:":8080",ReadHeaderTimeout:time.Second,ShutdownTimeout:time.Second}}
 server,cleanup,err:=bootstrap.Initialize(context.Background(),env,cfg);if err!=nil{t.Fatal(err)}
 t.Cleanup(func(){if err:=cleanup();err!=nil{t.Error(err)}})
 claims:=auth.Claims{RegisteredClaims:jwt.RegisteredClaims{Subject:"test-user",Issuer:"palma-api",Audience:jwt.ClaimStrings{"palma-api"},ExpiresAt:jwt.NewNumericDate(time.Now().Add(time.Hour))},Roles:[]string{"user"}}
 token,err:=jwt.NewWithClaims(jwt.SigningMethodHS256,claims).SignedString([]byte(secret));if err!=nil{t.Fatal(err)}
 for _,tc:=range []struct{path,header,body string;status int}{
  {"/auth/me","","unauthenticated",401},
  {"/auth/status","","\"authenticated\":false",200},
  {"/auth/me","Bearer "+token,"test-user",200},
  {"/auth/status","Bearer "+token,"\"authenticated\":true",200},
  {"/auth/me","Bearer invalid","unauthenticated",401},
  {"/auth/status","Bearer invalid","unauthenticated",401},
 }{
  r:=httptest.NewRequest("GET",tc.path,nil);if tc.header!=""{r.Header.Set("Authorization",tc.header)}
  w:=httptest.NewRecorder();server.HTTPServer().Handler.ServeHTTP(w,r)
  if w.Code!=tc.status||!strings.Contains(w.Body.String(),tc.body){t.Fatalf("%s: %d %s",tc.path,w.Code,w.Body)}
  if tc.status==401&&!strings.Contains(w.Header().Get("WWW-Authenticate"),"Bearer"){t.Fatal("bearer challenge missing")}
 }
}

func TestAuthStartupRequiresSecret(t *testing.T) {
 env, err := pfw.EnvironmentFromEnv("local")
 if err != nil { t.Fatal(err) }
 if env != "local" { t.Skip("startup fixture uses local item storage; constructor validation is tested in every environment") }
 for _, secret := range []string{"", "short"} {
  cfg := config.Config{Auth:authconfig.Config{JWTSecret:secret}}
  server, cleanup, err := bootstrap.Initialize(context.Background(),env,cfg)
  if cleanup != nil { _ = cleanup() }
  if server != nil || err == nil || !strings.Contains(err.Error(), "APP_AUTH_JWT_SECRET") {
   t.Fatalf("invalid auth configuration must stop startup: %v", err)
  }
 }
}
