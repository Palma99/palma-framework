package authhttp

import (
 "errors"
 "net/http"
 pfwhttp "github.com/palma99/palma-framework/http"
 "github.com/palma99/palma-framework/logging"
 "github.com/palma99/palma-framework/security"
 securityhttp "github.com/palma99/palma-framework/security/http"
 "{{.Module}}/internal/auth"
)

type Controller struct { middleware securityhttp.HandlerMiddleware; adapter *pfwhttp.HandlerAdapter }
//pfw:coconut
func NewController(middleware securityhttp.HandlerMiddleware, mapper pfwhttp.ErrorMapper, logger logging.Logger) *Controller {
 return &Controller{middleware:middleware, adapter:pfwhttp.NewHandlerAdapter(mapper,logger)}
}
func (c *Controller) Register(mux *http.ServeMux) {
 mux.Handle("GET /auth/me",auth.BearerChallenge(c.middleware.Required(c.adapter.Wrap(c.Me))))
 mux.Handle("GET /auth/status",auth.BearerChallenge(c.middleware.Optional(c.adapter.Wrap(c.Status))))
}
func (*Controller) Me(w http.ResponseWriter,r *http.Request) error {
 principal, err := security.Current[auth.Principal](r.Context())
 if err != nil { return err }
 return pfwhttp.OK(principal).Write(w)
}
func (*Controller) Status(w http.ResponseWriter,r *http.Request) error {
 _, err := security.Current[auth.Principal](r.Context())
 if errors.Is(err,security.ErrUnauthenticated) { return pfwhttp.OK(map[string]bool{"authenticated":false}).Write(w) }
 if err != nil { return err }
 return pfwhttp.OK(map[string]bool{"authenticated":true}).Write(w)
}
